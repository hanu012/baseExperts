APP_NAME="Service Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# "reverb" = live events to the apps (run `php artisan reverb:start`);
# "log" or "null" = off, the apps re-check when reopened instead.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = write the rendered email to storage/logs/laravel.log (local dev).
# resend = send for real; requires RESEND_API_KEY.
# Outgoing mail is used ONLY when admin Settings → Password reset is
# "Email link — sent by this server (Laravel)". With "log" nobody receives
# anything (the email is written to storage/logs). Use smtp (or ses,
# postmark, resend…) with real credentials to send for real.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@servicemarketplace.local"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# Where emailed reset / verification links point. Falls back to APP_URL.
FRONTEND_URL=

# Google Maps JavaScript key for the admin zone map. Rendered into the admin
# page, so restrict it in Google Cloud: HTTP referrers = your admin domain(s),
# APIs = Maps JavaScript API only. Separate from GOOGLE_MAPS_API_KEY below.
# Optional here: both keys can be set in the admin under Settings → Maps,
# which takes priority over these values.
GOOGLE_MAPS_BROWSER_KEY=
MAP_DEFAULT_LAT=
MAP_DEFAULT_LNG=
MAP_DEFAULT_ZOOM=

# Seed credentials for the first Filament admin:
#   php artisan db:seed --class=AdminUserSeeder
# Set these before seeding on any shared or deployed environment — the
# defaults in AdminUserSeeder are for local development only.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@servicemarketplace.local
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# FCM HTTP v1 (BUILD_PLAN 7.2) — a real Firebase service account's
# project id / client email / base64-encoded PEM private key. Blank
# until a real Firebase project exists — see the Before Launch
# Checklist. FcmClient fails loudly (not silently) if a push is
# attempted while these are blank.
# Firebase Web API key, for Settings → Password reset = "Email link — sent
# by Firebase" (can also be entered on that Settings page, which wins).
# Uses the same Firebase project and service account as FCM below.
FIREBASE_WEB_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_BASE64=

VITE_APP_NAME="${APP_NAME}"

# Base URL for files on the public disk. Defaults to APP_URL/storage.
# Point it at a real web server locally: `php artisan serve` truncates
# large static responses and the mobile apps see broken images.
FILESYSTEM_PUBLIC_URL=

# Google Places key for the admin zone map search (server-side only).
# Needs "Places API (New)" enabled in Google Cloud. Can also be set in the
# admin under Settings → Maps. Leave empty and the search box is hidden.
GOOGLE_MAPS_API_KEY=

# Razorpay Payment Links — only used while Settings → "Online payments via
# Razorpay" is on. Test mode: keys from Dashboard → Account & Settings → API
# keys (rzp_test_...). Webhook: Dashboard → Webhooks → URL
# https://<your-domain>/api/webhooks/razorpay, events payment_link.paid,
# payment_link.expired, payment_link.cancelled; its secret goes below.
# Optional here: all three can be set in the admin under Settings → Payments,
# which takes priority over these values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LINK_EXPIRY_MINUTES=1440

# Laravel Reverb — the WebSocket server for live app events.
# `php artisan reverb:install` fills ID/KEY/SECRET with random values.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where this server reaches Reverb (same machine).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the APPS reach it. In production put Reverb behind nginx on 443:
# REVERB_PUBLIC_HOST=api.yourdomain.com, PORT=443, SCHEME=https.
# Local Android emulator: 10.0.2.2 / 8080 / http.
REVERB_PUBLIC_HOST=10.0.2.2
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
