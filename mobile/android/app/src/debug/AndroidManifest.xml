<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: the local API and media server are plain HTTP.
         Android blocks cleartext by default from API 28 on, which is
         invisible for most of this app because Dart's HttpClient has its
         own socket stack and is not subject to the policy - but the video
         player uses Android's HTTP stack, so portfolio videos failed to
         open while the photos beside them loaded fine.

         Deliberately NOT in src/main: release builds must keep the
         default. Production serves media over HTTPS from R2, and a
         global opt-out would silently permit plaintext there too.
    -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
